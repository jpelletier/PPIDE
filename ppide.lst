     77				     ;	     * LBA0-3 ARE ALTERNATE DEFINITIONS	OF SECT,CYL,AND	DRVHD PORTS
     78				     ;
     79				     ;	     === STATUS	REGISTER ===
     80				     ;
     81				     ;		 7	 6	 5	 4	 3	 2	 1	 0
     82				     ;	     +-------+-------+-------+-------+-------+-------+-------+-------+
     83				     ;	     |	BSY  | DRDY  |	DWF  |	DSC  |	DRQ  | CORR  |	IDX  |	ERR  |
     84				     ;	     +-------+-------+-------+-------+-------+-------+-------+-------+
     85				     ;
     86				     ;	     BSY:    BUSY
     87				     ;	     DRDY:   DRIVE READY
     88				     ;	     DWF:    DRIVE WRITE FAULT
     89				     ;	     DSC:    DRIVE SEEK	COMPLETE
     90				     ;	     DRQ:    DATA REQUEST
     91				     ;	     CORR:   CORRECTED DATA
     92				     ;	     IDX:    INDEX
     93				     ;	     ERR:    ERROR
     94				     ;
     95				     ;	     === ERROR REGISTER	===
     96				     ;
     97				     ;		 7	 6	 5	 4	 3	 2	 1	 0
     98				     ;	     +-------+-------+-------+-------+-------+-------+-------+-------+
     99				     ;	     | BBK   |	UNC  |	MC   |	IDNF |	MCR  | ABRT  | TK0NF |	AMNF |
    100				     ;	     +-------+-------+-------+-------+-------+-------+-------+-------+
    101				     ;	     (VALID WHEN ERR BIT IS SET	IN STATUS REGISTER)
    102				     ;
    103				     ;	     BBK:    BAD BLOCK DETECTED
    104				     ;	     UNC:    UNCORRECTABLE DATA	ERROR
    105				     ;	     MC:     MEDIA CHANGED
    106				     ;	     IDNF:   ID	NOT FOUND
    107				     ;	     MCR:    MEDIA CHANGE REQUESTED
    108				     ;	     ABRT:   ABORTED COMMAND
    109				     ;	     TK0NF:  TRACK 0 NOT FOUND
    110				     ;	     AMNF:   ADDRESS MARK NOT FOUND
    111				     ;
    112				     ;	     === DRIVE/HEAD / LBA3 REGISTER ===
    113				     ;
    114				     ;		 7	 6	 5	 4	 3	 2	 1	 0
