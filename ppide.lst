    200				     ; =====================================================================
    201				     ; PPIDE Port Mapping (Base	0244h)
    202				     ; =====================================================================
    203	      =	0244		     PPIDE_DATALO = 0244h    ; IDE Data	Bus (D0-D7)
    204	      =	0245		     PPIDE_DATAHI = 0245h    ; IDE Data	Bus (D8-D15)
    205	      =	0246		     PPIDE_CTL	  = 0246h    ; IDE Control Signals
    206	      =	0247		     PPIDE_PPI	  = 0247h    ; 82C55 Control Register
    207
    208				     ; =====================================================================
    209				     ; Port C Control Bitmask Calculations (Inverted Logic)
    210				     ; Reset=0,IOR=0,IOW=0,CS1=0,CS0=0 mean pins are 5V	(Inactive)
    211				     ; =====================================================================
    212	      =	0008		     MSK_CS0 = 08h	; Pulls	/CS0 Active Low	(Target	Command	Block)
    213	      =	0020		     MSK_IOW = 20h	; Pulls	/IOW Active Low	(Write Strobe)
    214	      =	0040		     MSK_IOR = 40h	; Pulls	/IOR Active Low	(Read Strobe)
    215
    216				     ;------------------------------
    217				     ;## Part 1: Selecting an LBA Sector
    218				     ;To select	a sector,we must write a 28-bit	sector address across four
    219				     ;internal IDE registers: LBA Low,LBA Mid,LBA High,and Device/Head.
    220				     ;This routine expects you to pass the 28-bit LBA address via the Z80
    221				     ;registers:
    222
    223				     ;*	DE = Lower 16 bits of LBA
    224				     ;*	H = Upper 12 bits of LBA (Bits 0–7)
    225				     ;*	L = Upper 12 bits of LBA (Bits 8–11) — Note: Only bits 0-3 are used
    226				     ;here,mixed with the Master selection bit 0E0.
    227
    228				     ; =====================================================================
Turbo Assembler	 Version 2.0	    26/09/27 15:05:05	    Page 5
ppide.asm



    229				     ; ATA Command Set Definitions
    230				     ; =====================================================================
    231	      =	00EF		     CMD_SET_FEAT = 0EFh  ; ATA	Set Features Command
    232	      =	0001		     FEAT_8BIT_ON = 01h	  ; Sub-command	feature	code to	enable 8-bit PIO
    233
    234				     MDELAYN MACRO data
    235						     MOV	     CX,data
    236						     CALL    delayn
    237						     ENDM
    238
    239				     OUT_DX  MACRO port,data
    240						     MOV	     AL,data
    241						     MOV	     DX,port
    242						     OUT	     (DX),AL
    243						     ENDM
    244
    245				     IN_DX   MACRO port
    246						     MOV	     DX,port
    247						     IN		     AL,(DX)
    248						     ENDM
    249
    250				     LD_BX   MACRO reg,data
    251						     MOV	     BH,reg
    252						     MOV	     BL,data
    253						     ENDM
    254
    255	0000					     .MODEL  SMALL, C
    256	0000					     .CODE
    257				     ;CODE   SEGMENT _TEXT PUBLIC CLASS=CODE USE16 ALIGN=16  #DOESN'T WORK
    258				     ;CODE    SEGMENT BYTE PUBLIC
    259				     ;	      ASSUME CS:CODE
    260
    261				     ; 4.77MHz = 4772726 cycles	for 1s,	4772 cycles for	1ms
    262				     ; call		     23
    263				     ; push cx		     15
    264				     ; mov   cx,#n   4
    265				     ; loop:
    266				     ; nop		     3
    267				     ; loop		     5/17    nj/j
    268				     ; pop   ax		     12
    269				     ; ret		     20
    270
    271				     ; 23 + 15 + 4 + 12	+ 20 + (n-1)(3+17) + 5
    272				     ; 23 + 15 + 4 + 12	+ 20 -20 + 5 + 20n
    273				     ; 59 + 20n
    274				     ; 4772 = 59 + 20n
    275				     ; 4713 = 20n
    276				     ; n = 235.65
    277	0000			     delay1ms:
    278	0000  51				     PUSH    CX
    279	0001  B9 00EC				     MOV     CX,236
    280	0004			     delay_loop:
    281	0004  90				     NOP
    282	0005  E2 FD				     LOOP    delay_loop
    283	0007  59				     POP	     CX
    284	0008  C3				     RET
    285
