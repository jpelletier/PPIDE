    382						     OUT_DX  PPIDE_PPI,PPIDE_DIR_WRITE
1   383	006C  B0 80				     MOV	     AL,PPIDE_DIR_WRITE
1   384	006E  BA 0247				     MOV	     DX,PPIDE_PPI
1   385	0071  EE				     OUT	     (DX),AL
