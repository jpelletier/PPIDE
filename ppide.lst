      3				     ;	 PPIDE DISK DRIVER
      4				     ;=============================================================================
      5				     ; THE CONTROL PORT	OF THE 8255 IS PROGRAMMED AS NEEDED TO READ OR WRITE
      6				     ; DATA ON THE IDE BUS.  PORT C OF THE 8255	IS ALWAYS IN OUTPUT MODE BECAUSE
      7				     ; IT IS DRIVING THE ADDRESS BUS AND CONTROL SIGNALS.  PORTS A & B WILL BE
      8				     ; PLACED IN READ OR WRITE MODE DEPENDING ON THE DIRECTION OF THE DATA BUS.
      9				     ;
     10	      =	0092		     PPIDE_DIR_READ  = 92h   ; IDE BUS DATA INPUT MODE
     11	      =	0080		     PPIDE_DIR_WRITE = 80h   ; IDE BUS DATA OUTPUT MODE
     12	      =	0080		     PPIDE_CTL_RESET = 80h   ; DRIVE RESET (ACTIVE LOW,INVERTED)
     13
     14				     ;CTL_IDLE	     = 00h
     15	      =	0008		     CTL_BYTE	     = 08h
     16	      =	0009		     CTL_FEAT	     = 09h
     17	      =	000A		     CTL_DRHD	     = 0Ah
     18	      =	000B		     CTL_LBA_LOW     = 0Bh
     19	      =	000C		     CTL_LBA_MID     = 0Ch
     20	      =	000D		     CTL_LBA_HIG     = 0Dh
     21	      =	000E		     CTL_MAS_LBA     = 0Eh
     22	      =	000F		     CTL_CMD	     = 0Fh
     23
     24	      =	0008		     CTL_PRELOAD = 08h
     25	      =	0009		     CTL_ERROR	 = 09h
     26	      =	000F		     CTL_STATUS	     = 0Fh
     27
