    286				     PUBLIC  SELMST
    287	0009			     SELMST  PROC    NEAR
    288						     LD_BX   CTL_MAS_LBA,PPIDE_DRVMASTER
1   289	0009  B7 0E				     MOV	     BH,CTL_MAS_LBA
1   290	000B  B3 E0				     MOV	     BL,PPIDE_DRVMASTER
    291						     ; 7. Select Master	Drive and Force	LBA Mode (Crucial step)
    292	000D  EB 5D				     JMP	     writeReg
    293	000F			     SELMST  ENDP
    294
    295				     PUBLIC  SELPIO8
    296	000F			     SELPIO8 PROC    NEAR
    297						     ;Force Drive into 8-Bit PIO Transfer Mode via Features Register
    298						     ; This ensures the	drive doesn't expect data transitions on Port B	(D8-D15).
    299						     ; Write Feature Code (01h)	-> Register 1 (Features)
    300						     LD_BX   CTL_FEAT,FEAT_8BIT_ON
1   301	000F  B7 09				     MOV	     BH,CTL_FEAT
1   302	0011  B3 01				     MOV	     BL,FEAT_8BIT_ON
    303	0013  E8 0056				     call    writeReg
    304
    305						     ; Issue Set Features Command (EFh)	-> Register 7 (Command)
    306						     LD_BX   CTL_CMD,CMD_SET_FEAT
1   307	0016  B7 0F				     MOV	     BH,CTL_CMD
1   308	0018  B3 EF				     MOV	     BL,CMD_SET_FEAT
    309	001A  EB 50				     JMP	     writeReg
    310	001C			     SELPIO8 ENDP
    311
    312				     ; 4772.726	= 1ms
    313				     ; 4.772726	= 1µs
    314				     ; 238.6363	= 50µs
    315				     ; 239 = 59	+ 20n
    316
    317	001C			     initDelay:
    318						     ; Hold Reset Active for a short loop (~25-50 microseconds)
    319	001C  51				     PUSH    CX
    320	001D  B9 000A				     MOV	     CX,10
    321	0020			     initDelayLoop:
    322	0020  90				     NOP
    323	0021  E2 FD				     LOOP    initDelayLoop
    324	0023  59				     POP	     CX
    325	0024  C3				     RET
    326
