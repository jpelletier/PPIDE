    763				     ;----------------------------------------------------------------------
    764				     ; PROBE FOR PPI HARDWARE
    765				     ;----------------------------------------------------------------------
    766				     ;
    767				     ; ON RETURN,0xFF INDICATES	HARDWARE FOUND
    768				     PUBLIC  IDE_DETECT
    769	01EF			     IDE_DETECT	PROC NEAR
    770						     ; TEST FOR	PPI EXISTENCE
    771						     ; WE SETUP	THE PPI	TO WRITE,THEN WRITE A VALUE OF $A5
    772						     ; TO PORT A (DATALO),THEN READ IT BACK.  IF THE PPI IS THERE
    773						     ; THEN THE	BUS HOLD CIRCUITRY WILL	READ BACK THE $A5. SINCE
    774						     ; WE ARE IN WRITE MODE,AN IDE CONTROLLER WILL NOT BE ABLE TO
    775						     ; INTERFERE WITH THE VALUE	BEING READ.
    776						     OUT_DX  PPIDE_PPI,PPIDE_DIR_WRITE
1   777	01EF  B0 80				     MOV	     AL,PPIDE_DIR_WRITE
1   778	01F1  BA 0247				     MOV	     DX,PPIDE_PPI
1   779	01F4  EE				     OUT	     (DX),AL
    780
    781						     OUT_DX  PPIDE_DATALO,0A5h	     ; TEST VALUE
1   782	01F5  B0 A5				     MOV	     AL,0A5h
1   783	01F7  BA 0244				     MOV	     DX,PPIDE_DATALO
1   784	01FA  EE				     OUT	     (DX),AL
    785	01FB  EC				     IN		     AL,(DX)			     ; GET PORT	VALUE
    786	01FC  34 A5				     XOR	     AL,0A5h			     ; CHECK FOR TEST VALUE
    787	01FE  F6 D0				     NOT	     AL
1   788	0200  C3			     RET     0000h
    789	0201			     IDE_DETECT	ENDP
