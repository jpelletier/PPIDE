    328				     ;return AL
    329	0025			     readPulse:
    330	0025  BA 0246				     MOV	     DX,PPIDE_CTL
    331	0028  EE				     OUT	     (DX),AL
    332	0029  0C 40				     OR		     AL,MSK_IOR
    333	002B  EE				     OUT	     (DX),AL
    334	002C  BA 0244				     MOV	     DX,PPIDE_DATALO
    335	002F  EC				     IN	     AL,(DX)
    336	0030  8A E0				     MOV	     AH,AL
    337	0032  32 C0				     XOR	     AL,AL
    338	0034  BA 0246				     MOV	     DX,PPIDE_CTL
    339	0037  EE				     OUT	     (DX),AL
    340	0038  8A C4				     MOV	     AL,AH
    341	003A  C3				     RET
    342
