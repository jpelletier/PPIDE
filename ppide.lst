    664				     ; =====================================================================
    665				     ;Word Offset    Byte Offset     Field Description	     Format
    666				     ;Words 10–19  014h – 027h   Serial Number		     20-character ASCII	string
    667				     ;Words 27–46  036h – 05Dh   Model Number/Name		     40-character ASCII	string
    668				     ;Words 60–61  078h – 07Bh   Total LBA Sectors	     32-bit Integer (Capacity)
    669				     ;
    670				     ;Z80 Byte-Swap Warning: ATA stores	strings	with the bytes swapped inside
    671				     ;each word	(e.g.,characters 214365... instead of 123456...). When parsing
    672				     ;this text	with a Z80,you must swap adjacent bytes	before printing	them.
    673				     ;
    674				     ; ON RETURN,ZF SET	INDICATES HARDWARE FOUND
    675				     PUBLIC  IDE_GET_DISK_INFO
